# Self-hosted Overwatch — copy to .env and fill in. Never commit the copy.
#
# Every value here stays on YOUR machine. The selfhost edition has no billing
# surface, phones nowhere, and needs no account with anyone — the one external
# dependency is the public SatNOGS/TLE open-data endpoints the ingest reads.

# The URL your users will open. For a first local run:
#   PUBLIC_BASE=http://localhost:8080
# For a real deployment, your https:// domain (terminate TLS in front of the
# caddy port, or edit selfhost/Caddyfile to let Caddy issue certificates).
PUBLIC_BASE=http://localhost:8080

# Where the caddy front listens on the host (host:port published to caddy:80).
HTTP_BIND=0.0.0.0:8080

# Generate every secret below with e.g.:  openssl rand -hex 24
PG_PASSWORD=
KC_DB_PASSWORD=
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=
OVERWATCH_CLIENT_SECRET=
ORG_DB_SECRET=
GF_ADMIN_PASSWORD=

# Open-data ingest (recommended): enables the SatNOGS/TLE feed so the globe is
# alive out of the box. Comment out to run a data-empty control room.
COMPOSE_PROFILES=data
# Optional — raises SatNOGS rate limits; works without it.
SATNOGS_TOKEN=

# Optional mail relay. Without it, e-mail verification and password reset stay
# OFF (users register and sign in directly — nothing locks them out).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
