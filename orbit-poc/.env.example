# Copy to .env before `podman-compose up` (compose references it via env_file).
# NEVER commit .env — it holds the real secrets. This file documents every
# variable the stack reads.

# --- Database credentials --------------------------------------------------
# The Postgres password is NOT hard-coded in the compose files anymore; it is
# read from here.
#   POSTGRES_PASSWORD  — bootstrap superuser (orbit) password, set on FIRST
#                        init (fresh volume only); maintenance/migrations only
#   DB_DSN             — connection string used by api / web / ingest. Points
#                        at the least-privilege OWNER role `orbit_app`, never
#                        the bootstrap superuser (#133). Create/refresh it:
#                        DB_CONTAINER=<db> APP_PASSWORD=<app pw> \
#                          python3 orbit-poc/db/pg_app_role.py
#   DB_PASSWORD        — same secret as POSTGRES_PASSWORD, read by Grafana's
#                        datasource ($__env)
# Generate strong ones:  openssl rand -base64 24
# Rotating an EXISTING db: also run  ALTER USER orbit PASSWORD '<new>';  then
# recreate the services (the value is only applied at init otherwise).
DB_PASSWORD=change-me-strong
POSTGRES_PASSWORD=change-me-strong
DB_DSN=dbname=orbit user=orbit_app password=change-me-app-strong host=db port=5432

# Password for `ops_ro`, the read-only role behind the admin-only ops Grafana
# org's datasource (#168) — SELECT on account/metering tables only. The api
# provisions the role and the ops org at startup; leave empty to skip both.
OPS_DB_PASSWORD=change-me-ops-strong

# --- Signup e-mail alerts (#172) --------------------------------------------
# Grafana mails the ops alerts (new registration, new API key) to
# OPS_ALERT_EMAIL. The non-secret Grafana SMTP config (host/user/from/…) now
# lives as code in each stack's docker-compose.yml (#183, OVH/EU); here you only
# set the mailbox password. E-mails flow once GF_SMTP_PASSWORD is filled in.
# OPS_ALERT_EMAIL=contact@confinia.io
# GF_SMTP_PASSWORD=change-me

# --- SatNOGS ---------------------------------------------------------------
# Free SatNOGS API key — enables the telemetry ingest/dashboards.
# Leave empty and the map + orbit tracks still work fully.
SATNOGS_TOKEN=

# --- Grafana ---------------------------------------------------------------
# Grafana admin password (anonymous viewers stay read-only; this protects
# the admin account). Generate one: openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=change-me

# --- Public API observability ----------------------------------------------
# Salt for unique-visitor hashing in the public API (never the IP itself —
# a salted daily digest). Empty = unique-visitor counting disabled.
# Generate one: openssl rand -base64 24
VISITOR_SALT_SECRET=

# --- Per-org RLS (private tenants) -----------------------------------------
# Secret used to derive each org's read-only Postgres role password (RLS
# isolation behind per-tenant Grafana). Empty = provisioning skipped
# (self-host / tests may skip). Generate one: openssl rand -base64 24
ORG_DB_SECRET=

# Grafana datasource role (SECURITY #129). Grafana's datasource proxy executes
# arbitrary SQL for ANY caller — including the anonymous Viewer the public
# embeds require — so the datasource must NOT use the app's `orbit` role.
# The API provisions a `grafana_ro` role (NOSUPERUSER, NOBYPASSRLS, SELECT on
# the public tables only) with this password; Grafana authenticates with it.
#   openssl rand -hex 20
GRAFANA_DB_PASSWORD=
