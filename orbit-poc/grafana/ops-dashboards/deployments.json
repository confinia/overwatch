{
 "uid": "deployments",
 "title": "Deployments",
 "description": "Every change on its way to production: unit tests, the per-PR sandbox and its e2e, staging (stage) and prod (promote), each with the PR and issues it was for (#470, rule 34). Test/sandbox rows come from the GitHub API via statusmon; staging/prod rows are written by deploy.yml.",
 "schemaVersion": 39,
 "time": {
  "from": "now-14d",
  "to": "now"
 },
 "refresh": "5m",
 "panels": [
  {
   "id": 1,
   "title": "Tests",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "orbitcache-ops"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 0
   },
   "description": "Age of the last completed unit-tests run on any branch; FAILING when it was red.",
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": -1.5,
        "to": -0.5,
        "result": {
         "text": "FAILING",
         "color": "red"
        }
       }
      },
      {
       "type": "special",
       "options": {
        "match": "null",
        "result": {
         "text": "no run yet",
         "color": "text"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "format": "table",
     "refId": "A",
     "rawSql": "SELECT CASE WHEN conclusion='success' THEN date_part('epoch', now() - updated) ELSE -1 END AS age FROM pipeline_run WHERE workflow='unit tests' AND status='completed' ORDER BY created DESC LIMIT 1",
     "datasource": {
      "type": "postgres",
      "uid": "orbitcache-ops"
     }
    }
   ]
  },
  {
   "id": 2,
   "title": "Sandbox",
