     "rawSql": "SELECT CASE WHEN conclusion='success' THEN date_part('epoch', now() - updated) ELSE -1 END AS age FROM pipeline_run WHERE workflow='e2e (sandbox)' AND status='completed' ORDER BY created DESC LIMIT 1",
     "datasource": {
