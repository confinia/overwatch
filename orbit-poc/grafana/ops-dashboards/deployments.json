  {
   "id": 4,
   "title": "Production",
   "type": "stat",
   "datasource": {
    "type": "postgres",
    "uid": "orbitcache-ops"
   },
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 18,
    "y": 0
   },
   "description": "Since the last promote. Orange after 3 days, red after a week (rule 26).",
   "fieldConfig": {
    "defaults": {
     "unit": "dtdurations",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 259200
       },
       {
        "color": "red",
        "value": 604800
       }
      ]
     },
     "mappings": [
      {
       "type": "range",
       "options": {
        "from": -1.5,
