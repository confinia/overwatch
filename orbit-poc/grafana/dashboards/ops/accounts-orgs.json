{
  "uid": "accounts-orgs",
  "title": "Accounts & organizations",
  "description": "Internal admin view of the account/tenant model: organizations, members, service tokens, API-key leads, signups over time (#28). Reads the org model in Postgres; admin-only (ops folder).",
  "tags": [
    "ops",
    "accounts"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Active organizations",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM organization WHERE active AND archived_at IS NULL",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Members (distinct users)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(DISTINCT sub) AS value FROM org_user",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "API-key accounts (leads)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM api_key WHERE active",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Archived organizations",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM organization WHERE archived_at IS NOT NULL",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "New organizations / day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS \"orgs\" FROM organization GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "New API-key accounts / day",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "barAlignment": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT date_trunc('day', created_at) AS time, count(*) AS \"accounts\" FROM api_key GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Organizations \u2014 members, tokens, status",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT o.name AS \"Organization\", o.created_at AS \"Created\", (SELECT count(*) FROM org_user u WHERE u.org = o.id) AS \"Members\", (SELECT count(*) FROM org_token t WHERE t.org = o.id AND NOT t.revoked) AS \"Active tokens\", CASE WHEN o.archived_at IS NOT NULL THEN 'archived' WHEN o.active THEN 'active' ELSE 'inactive' END AS \"Status\" FROM organization o ORDER BY o.created_at DESC",
          "refId": "A"
        }
      ]
    }
  ]
}
