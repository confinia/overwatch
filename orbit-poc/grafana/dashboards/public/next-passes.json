{
  "uid": "next-passes",
  "title": "Next Passes",
  "tags": [
    "orbit-poc"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": {
    "from": "now",
    "to": "now+2d"
  },
  "templating": {
    "list": [
      {
        "name": "station",
        "label": "Ground station",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "orbitcache"
        },
        "query": "SELECT DISTINCT observer FROM pass ORDER BY 1",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "norad",
        "label": "Satellite (NORAD)",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "orbitcache"
        },
        "query": "SELECT DISTINCT norad FROM pass ORDER BY 1",
        "refresh": 1,
        "sort": 3,
        "includeAll": false,
        "multi": false,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "state-timeline",
      "title": "Coverage timeline \u2014 ground stations seeing this satellite",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "id": 3,
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT p.aos AS time, p.max_el_deg AS value, p.observer AS metric FROM pass p JOIN satellite s USING (norad) WHERE p.aos > now() AND p.norad = $norad UNION ALL SELECT p.los AS time, NULL AS value, p.observer AS metric FROM pass p JOIN satellite s USING (norad) WHERE p.aos > now() AND p.norad = $norad ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "orbitcache"
          }
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "unit": "deg",
          "min": 0,
          "max": 90,
          "noValue": "no pass"
        },
        "overrides": []
      }
    },
    {
      "type": "state-timeline",
      "title": "Coverage timeline \u2014 satellites passing over $station",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "id": 4,
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT p.aos AS time, p.max_el_deg AS value, s.name AS metric FROM pass p JOIN satellite s USING (norad) WHERE p.aos > now() AND p.observer = '$station' UNION ALL SELECT p.los AS time, NULL AS value, s.name AS metric FROM pass p JOIN satellite s USING (norad) WHERE p.aos > now() AND p.observer = '$station' ORDER BY 1",
          "datasource": {
            "type": "postgres",
            "uid": "orbitcache"
          }
        }
      ],
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "unit": "deg",
          "min": 0,
          "max": 90,
          "noValue": "no pass"
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Next passes over $station (which satellites)",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "id": 1,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT s.name AS satellite, p.aos AS \"AOS (UTC)\", round(p.max_el_deg::numeric, 0) AS \"max el (deg)\", round(extract(epoch FROM (p.los - p.aos))/60) AS \"duration (min)\", round(extract(epoch FROM (p.aos - now()))/3600, 1) AS \"AOS in (h)\" FROM pass p JOIN satellite s USING (norad) WHERE p.aos > now() AND p.observer = '$station' ORDER BY p.aos LIMIT 200",
          "datasource": {
            "type": "postgres",
            "uid": "orbitcache"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "AOS (UTC)",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "AOS in (h)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 1,
                      "color": "orange"
                    },
                    {
                      "value": 24,
                      "color": "yellow"
                    },
                    {
                      "value": 168,
                      "color": "transparent"
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max el (deg)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "deg"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Ground stations covering the satellite (next passes)",
      "datasource": {
        "type": "postgres",
        "uid": "orbitcache"
      },
      "id": 2,
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT p.observer AS \"ground station\", p.aos AS \"AOS (UTC)\", round(p.max_el_deg::numeric, 0) AS \"max el (deg)\", round(extract(epoch FROM (p.los - p.aos))/60) AS \"duration (min)\", round(extract(epoch FROM (p.aos - now()))/3600, 1) AS \"AOS in (h)\" FROM pass p WHERE p.aos > now() AND p.norad = $norad ORDER BY p.aos LIMIT 200",
          "datasource": {
            "type": "postgres",
            "uid": "orbitcache"
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "AOS (UTC)",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "AOS in (h)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "value": null,
                      "color": "red"
                    },
                    {
                      "value": 1,
                      "color": "orange"
                    },
                    {
                      "value": 24,
                      "color": "yellow"
                    },
                    {
                      "value": 168,
                      "color": "transparent"
                    }
                  ]
                }
              },
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "max el (deg)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "deg"
              }
            ]
          }
        ]
      }
    }
  ]
}