# Overwatch's OWN caddy — every overwatch routing decision lives here,
# inside the overwatch stack. TLS terminates at the shared confinia edge,
# which forwards plain HTTP (Host header preserved) for both hostnames to
# this server via 127.0.0.1:8090. The edge-side file is a 3-line stub
# (deploy/caddy/overwatch.caddy at the repo root) that never changes —
# confinia-side deploys can no longer break overwatch routing.
#
# TEMPLATE — deploy/slots.sh substitutes %LIVE% / %CANDIDATE% (blue|green)
# and writes the real Caddyfile next to this file, then graceful-reloads.
# Upstreams are container DNS names on the shared compose network
# (orbit-poc_default): <color>_web_1 / <color>_api_1 from the color
# stacks (docker-compose.blue|green.yml) and the compose-managed grafana.

{
	auto_https off
	# admin API stays on (localhost inside the container only): it is what
	# `caddy reload` uses for the graceful color swap.
	servers {
		# The edge connects from container/loopback space; trust it so
		# X-Forwarded-For (real client IP) flows through to the api's
		# rate limiter / GeoIP and to our access log.
		trusted_proxies static private_ranges
	}
}

# ---- production ------------------------------------------------------------
http://overwatch.confinia.io {
	encode zstd gzip

	# JSON access log (was on the edge before 2026-07-20; now self-owned).
	# Read: podman exec orbit-poc_caddy_1 tail /data/logs/access.log
	log {
		output file /data/logs/access.log {
			roll_size 20MiB
			roll_keep 5
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self' https://confinia.github.io"
		X-Overwatch-Env "production"
		# Which colour is promoted, for the platform dashboard (#323). It is
		# %LIVE% rather than a literal because slots.sh rewrites this file on
		# every promote: there is no path that repoints the proxy without also
		# updating the header, so it cannot drift into claiming blue while
		# green serves. Emitted here rather than by the app so it survives a
		# 302, a 401 or a 500 — when knowing the colour matters most.
		# Caveat: with lb_policy first, a failed health check lets the
		# candidate answer while this still names the promoted colour.
		X-Active-Colour "%LIVE%"
		-Server
	}

	# Blue/green: LIVE color first, CANDIDATE second (lb_policy first +
	# health checks). A promote regenerates this file with the colors
	# swapped + graceful reload — no container restarts, and the old
	# color keeps running as instant rollback.
	# Public product API at /api/v1 (decision 2026-07-20 evening). The
	# service keeps /v1 internally; the /api prefix is stripped here.
	# MUST stay above the generic /api/* handler (first match wins).
	handle /api/v1* {
		uri strip_prefix /api
		# No CORS header here (#365): the api's own CORSMiddleware already
		# sends Access-Control-Allow-Origin, and adding a second copy at the
		# proxy makes browsers REJECT the response — duplicate ACAO is an
		# error, not a merge. The mobile app (confinia/overwatch-mobile)
		# relies on the upstream header alone.
		reverse_proxy %LIVE%_api_1:8000 %CANDIDATE%_api_1:8000 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
		}
	}

	# Legacy /v1 URLs are published (Mastodon, replies) — permanent,
	# method-preserving redirect so POST /v1/keys keeps working too.
	handle /v1* {
		redir * /api{uri} 308
	}

	# Bare /api -> the API landing (humans type it; nothing serves it raw).
	redir /api /api/v1 308
	redir /api/ /api/v1 308

	handle /api/* {
		header Access-Control-Allow-Origin "https://confinia.github.io"
		header Access-Control-Allow-Methods "GET"
		reverse_proxy %LIVE%_web_1:8080 %CANDIDATE%_web_1:8080 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
		}
	}

	# Grafana under /grafana sub-path (GF_SERVER_SERVE_FROM_SUB_PATH) —
	# same-origin iframe embedding, no path stripping.
	handle /grafana* {
		reverse_proxy grafana:3000
	}

	# v2 identity: Keycloak (isolated ovw2 stack) serves /auth — realm
	# "overwatch", self-registration on. Caddy joins the ovw2 network.
	handle /auth* {
		reverse_proxy ovw2_keycloak_1:8080
	}

	handle {
		reverse_proxy %LIVE%_web_1:8080 %CANDIDATE%_web_1:8080 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
		}
	}
}

# staging.overwatch.confinia.io is NOT served here any more: it runs its OWN
# stack on the dedicated port 8200, with its OWN database (#154). Sharing the
# production database meant a test signup wrote into real accounts, and the
# blue/green roles rotate at every promote so the database could not be pinned
# in a colour either. The platform edge proxies the staging host to :8200.

# ---- Grafana on its own memorable hostname ---------------------------------
# grafana.overwatch.confinia.io answers, but the CANONICAL origin stays
# overwatch.confinia.io/grafana: GF_SERVER_ROOT_URL, the app's same-origin
# iframes, CSP frame-ancestors 'self' and the Keycloak OIDC redirect URIs all
# assume it. A 308 gives the memorable name without touching any of them
# (#386); a full origin migration is its own issue if a real need appears.
http://grafana.overwatch.confinia.io {
	redir * https://overwatch.confinia.io/grafana{uri} 308
}

# ---- production API on its own hostname ------------------------------------
# api.overwatch.confinia.io serves the public API at the root (/v1/...), with
# no /api prefix. /api/v1/... keeps working here too: FastAPI runs with
# root_path=/api, so its docs and openapi.json resolve URLs under that prefix —
# stripping it lets /v1/docs work on this host as well.
http://api.overwatch.confinia.io {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Overwatch-Env "production"
		X-Active-Colour "%LIVE%"
		-Server
	}

	handle /api/v1* {
		uri strip_prefix /api
		# No CORS header here (#365): the api's own CORSMiddleware already
		# sends Access-Control-Allow-Origin, and adding a second copy at the
		# proxy makes browsers REJECT the response — duplicate ACAO is an
		# error, not a merge. The mobile app (confinia/overwatch-mobile)
		# relies on the upstream header alone.
		reverse_proxy %LIVE%_api_1:8000 %CANDIDATE%_api_1:8000 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
		}
	}

	handle /v1* {
		reverse_proxy %LIVE%_api_1:8000 %CANDIDATE%_api_1:8000 {
			lb_policy first
			lb_try_duration 3s
			lb_try_interval 250ms
			health_uri /healthz
			health_interval 2s
			health_timeout 2s
		}
	}

	handle {
		redir * /v1 308
	}
}

# The sandbox (sandbox.overwatch.confinia.io, sandbox.api.overwatch.confinia.io)
# is NOT served here: it runs its OWN caddy on the dedicated port 8190 (compose
# project ovw-sandbox, see orbit-poc/sandbox/Caddyfile). The platform upstream
# edge proxies the sandbox hosts straight to 127.0.0.1:8190, so a down sandbox
# never touches this caddy.
