  "measures": [
    {
      "measure": "temperature",
      "unit": "degC",
      "range": [
        -60,
        120
      ],
      "match": "(^|_)(temp|temperature|thermistor|therm|tmp[0-9]*|temp[0-9]+|t|tbrd|tpcb|tmcu|tbat[0-9]*|tbcr[ab][0-9]+)(_|$)|_temp_"
    },
    {
      "measure": "voltage",
      "unit": "V",
      "range": [
        0,
        60
      ],
      "match": "(^|_)(v|vbat|vbatt|volt|volts|volt[0-9]+|voltage|vbus|vcc|vdd|vin|vout|bus_v|bus_vol|battery_v|v[0-9]+(_[0-9]+)?|vpcm[0-9a-z]*|psu_battery|obc_bat|rtc_bat)(_|$)|_v[0-9]*$|voltage"
    },
    {
      "measure": "current",
      "unit": "A",
      "range": [
        -20,
        20
      ],
      "match": "(^|_)(i|cur|curr|current|amp|amps|amp[0-9]+|ma|battery_i|charging_current|ipcm[0-9a-z]*|ibat|iin|iout|isens|ibcr[ab][0-9]+|iidiodeout|i[0-9]v[0-9a-z]+drw|bus_c|uc_c)(_|$)|_i[0-9]*$|current"
    },
    {
      "measure": "power",
      "unit": "W",
      "range": [
        -100,
        200
      ],
      "match": "(^|_)(power|pwr|watt|watts|power[0-9]+)(_|$)|_power(_|$)"
    },
    {
      "measure": "charge",
      "unit": "% or mAh",
      "range": [
        0,
        100000
      ],
      "match": "(^|_)(soc|state_of_charge|battery_pct|battery_percent|percent|pct|charge_level|charge|capacity|energy)(_|$)|charge_level|m_ah$"
    },
    {
      "measure": "signal",
      "unit": "dB",
      "range": [
        -160,
        60
      ],
      "match": "(^|_)(rssi|snr|signal|lqi|agc|afc|s_meter|background_noise|noise)(_|$)|s_meter"
    },
    {
      "measure": "frequency",
      "unit": "Hz / bit/s",
      "range": [
        0,
        100000000000
      ],
      "match": "(^|_)(freq|frequency|hz|khz|mhz|baud|datarate|rx_baud|tx_baud)(_|$)|datarate"
    },
    {
      "measure": "position",
      "unit": "deg / km",
      "range": [
        -180,
        40000
      ],
      "match": "(^|_)(lat|latitude|lon|longitude|alt|altitude|height|gps|glonass|position|pos|nav|dop|sats|week)(_|$)|latitude|longitude"
    },
    {
      "measure": "memory",
      "unit": "bytes",
      "range": [
        0,
        4294967295
      ],
      "match": "(^|_)(freemem|heap|ram|rom|flash|mem|memory|stack|bytes|rx_bytes|tx_bytes|lo_bytes|vmalloc_used)(_|$)"
    },
    {
      "measure": "attitude",
      "unit": "deg, deg/s, nT",
      "range": [
        -100000,
        100000
      ],
      "match": "(^|_)(gyro|gyr|mag|magnetometer|magnetic|quaternion|q[0-3]|omega|rate|sun_sensor|sun|angle|attitude|adcs|accel|acc|vcty|velocity|vel|spin|diode|bdot)(_|$)"
    },
    {
      "measure": "counter",
      "unit": "n",
      "range": [
        0,
        4294967295
      ],
      "match": "(^|_)(uptime|boot|boots|reboot|reboots|reset|resets|restart|restarts|rsts|wdt|count|counter|counts|cnt|errors|retries|packets|frames|tx_count|rx_count|number|pointer|index|total|looptime|load|procs|processes|erasures|of_range|ms|time_ms|uplink_ms|duty)(_|$)|_count(_|$)|_counter(_|$)|_number(_|$)|load_[0-9]+min"
    },
    {
      "measure": "state",
      "unit": "enum",
      "range": null,
      "match": "(^|_)(mode|state|status|flag|flags|enable|enabled|on|off|armed|deployed|deployment|depl|deploy|switch|lock|locked|valid|ok|error|fault|alarm|bootcause|resetcause|inited|ind|permission|dmode|has|is)(_|$)|_state(_|$)|_mode(_|$)|_status(_|$)|ant_deploy|^has_|^is_|_has_|_is_"
    }
  ],
