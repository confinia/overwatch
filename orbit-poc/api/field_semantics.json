{
  "_about": [
    "Field semantics (#526): what a decoded field IS, as data. Two decisions, in order:",
    "1. scaffolding — frame plumbing that must never be plotted: a field whose LAST",
    "   path segment is in `scaffolding_leaves`, or whose path contains a segment in",
    "   `scaffolding_segments`. Segments are matched whole: `ax25_header` is framing,",
    "   `ax25_frame` is the container most decoders put the payload in (767 of the",
    "   fleet's 1315 fields sit under it), so it is NOT a marker.",
    "2. measure — the first entry of `measures` whose `match` regex hits the lowercase",
    "   field wins; `unit` and `range` describe what a plausible value looks like.",
    "   Order matters: `temperature` sits before `current` so `..._temp_i` is a temperature.",
    "`overrides` correct the guess per decoder, by leaf: a value of a measure name,",
    "\"scaffolding\" or \"unknown\". A wrong guess is a one-line edit here, not new SQL."
  ],
  "scaffolding_segments": [
    "csp_header", "ax25_header", "packet_header", "primary_header", "secondary_header",
    "frame_header", "transfer_frame", "header",
    "not_used", "reserved", "spare", "unused", "pad", "padding"
  ],
  "state_leaves": [
    "mode", "state", "status", "flag", "flags", "enable", "enabled", "ok", "valid",
    "error", "fault", "alarm", "bootcause", "resetcause", "inited", "ind", "permission",
    "dmode", "deployed", "deployment", "depl", "armed", "switch", "lock", "locked"
  ],
  "scaffolding_leaves": [
    "length", "frame_length", "header_length", "len",
    "crc", "crc16", "crc32", "checksum", "check", "fcs", "type_check",
    "callsign", "dest_callsign", "src_callsign", "source_callsign", "destination_callsign",
    "ssid", "dest_ssid", "src_ssid", "pid", "ctl", "control",
    "receiver_address", "transmitter_address", "transaction_number", "address", "dest", "src",
    "destination", "source", "source_port", "dest_port", "destination_port", "port", "priority",
    "seq", "seq_count", "sequence", "sequence_count", "sequence_number",
    "frame_number", "frame_count", "frame_id", "packet_id", "packet_number", "frame_definition",
    "frame_generation_time", "beacon_type", "type", "version", "firmware_version", "sw_version",
    "syncword", "sync_word", "spacecraft_id", "sat_id", "norad", "apid",
    "year", "month", "day", "hour", "hours", "minute", "minutes", "second", "seconds",
    "millis", "milliseconds", "timestamp", "time", "unix_time", "epoch", "date", "datetime",
    "magic", "preamble", "postamble",
    "hmac", "xtea", "rdp", "crc32c", "typeandlength", "command", "seqnum", "options", "flags_raw"
  ],
  "measures": [
    {"measure": "temperature", "unit": "degC", "range": [-60, 120],
     "match": "(^|_)(temp|temperature|thermistor|therm|tmp[0-9]*|temp[0-9]+|t|tbrd|tpcb|tmcu)(_|$)|_temp_"},
    {"measure": "voltage", "unit": "V", "range": [0, 60],
     "match": "(^|_)(v|vbat|vbatt|volt|volts|voltage|vbus|vcc|vdd|vin|vout|bus_v|battery_v|v[0-9]+(_[0-9]+)?|vpcm[0-9a-z]*)(_|$)|_v[0-9]*$|voltage"},
    {"measure": "current", "unit": "A", "range": [-20, 20],
     "match": "(^|_)(i|cur|curr|current|amp|amps|ma|battery_i|charging_current|ipcm[0-9a-z]*)(_|$)|_i[0-9]*$|current"},
    {"measure": "power", "unit": "W", "range": [-100, 200],
     "match": "(^|_)(power|pwr|watt|watts)(_|$)|_power(_|$)"},
    {"measure": "charge", "unit": "% or mAh", "range": [0, 100000],
     "match": "(^|_)(soc|state_of_charge|battery_pct|charge_level|charge|capacity|energy)(_|$)|charge_level|m_ah$"},
    {"measure": "signal", "unit": "dB", "range": [-160, 60],
     "match": "(^|_)(rssi|snr|signal|lqi|agc|afc|s_meter)(_|$)|s_meter"},
    {"measure": "memory", "unit": "bytes", "range": [0, 4294967295],
     "match": "(^|_)(freemem|heap|ram|rom|flash|mem|memory|stack)(_|$)"},
    {"measure": "frequency", "unit": "Hz", "range": [0, 100000000000],
     "match": "(^|_)(freq|frequency|hz|khz|mhz)(_|$)"},
    {"measure": "position", "unit": "deg / km", "range": [-180, 40000],
     "match": "(^|_)(lat|latitude|lon|longitude|alt|altitude|height|gps|glonass|position|pos)(_|$)|latitude|longitude"},
    {"measure": "attitude", "unit": "deg, deg/s, nT",
     "range": [-100000, 100000],
     "match": "(^|_)(gyro|gyr|mag|magnetometer|magnetic|quaternion|q[0-3]|omega|rate|sun_sensor|sun|angle|attitude|adcs|accel|acc|vcty|velocity|spin)(_|$)"},
    {"measure": "counter", "unit": "n", "range": [0, 4294967295],
     "match": "(^|_)(uptime|boot|boots|reboot|reboots|reset|resets|restart|restarts|rsts|wdt|count|counter|counts|cnt|errors|retries|packets|frames|tx_count|rx_count|number|pointer|index|total|looptime)(_|$)|_count(_|$)|_counter(_|$)|_number(_|$)"},
    {"measure": "state", "unit": "enum", "range": null,
     "match": "(^|_)(mode|state|status|flag|flags|enable|enabled|on|off|armed|deployed|deployment|depl|deploy|switch|lock|locked|valid|ok|error|fault|alarm|bootcause|resetcause|inited|ind|permission|dmode)(_|$)|_state(_|$)|_mode(_|$)|_status(_|$)|ant_deploy"}
  ],
  "overrides": {
    "_about": "decoder -> {leaf (1-4 trailing segments): measure | scaffolding | unknown}",
    "netsat": {"p": "power", "u": "voltage"},
    "co65": {"v3_3": "voltage", "v5": "voltage"},
    "catsat": {"ax25_frame_psu_battery": "voltage"}
  }
}
