# Overwatch SANDBOX — the sandbox's OWN application caddy (compose service
# `caddy`, published on 127.0.0.1:8190). The platform upstream edge terminates
# TLS for sandbox.overwatch.confinia.io + sandbox.api.overwatch.confinia.io and
# reverse-proxies here; this caddy is self-contained in the ovw-sandbox network
# and reaches the stack by service name (api / web / grafana). It shares NOTHING
# with the prod app caddy (orbit-poc_caddy_1:8090) — a down sandbox cannot
# affect prod routing.
#
# Gated (#290): every request carries a session cookie issued by the `gate`
# service (oauth2-proxy against the shared Keycloak's overwatch-gate realm,
# realm role `internal`) or is sent to log in. Open by design: the gate's own
# endpoints, the billing webhook (signature-verified, the provider POSTs it),
# the health probe the deploy checks, and the key-authenticated tenant API
# (machines push telemetry with their tenant key, not a browser session).

# Trust the platform edge (it connects from private/loopback space): pass the
# original X-Forwarded-Proto (https) and the real client IP through instead of
# overwriting them with this http listener's scheme. Without it, OIDC builds an
# http:// redirect_uri that the overwatch-sandbox realm rejects (#179). Mirrors
# the prod app caddy (deploy/caddy/Caddyfile.tmpl).
{
	servers {
		trusted_proxies static private_ranges
	}
}

# Shared by both sandbox hosts: the gate and the self-identifying headers.
(sandbox_common) {
	encode zstd gzip

	# The gate. Paths are listed in both host spellings (the web host strips
	# /api, the api host serves /v1 at the root) so moving an endpoint between
	# hosts never locks a machine caller out.
	@gated {
		not path /oauth2/* /api/v1/billing/webhook* /v1/billing/webhook* /api/v1/healthz /v1/healthz /api/v1/tenants/* /v1/tenants/*
	}
	forward_auth @gated gate:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-Email
		# no session: send the browser to log in and come back here. The edge
		# always terminates TLS, so the return address is spelled https.
		@nosession status 401
		handle_response @nosession {
			redir * /oauth2/start?rd=https://{host}{uri}
		}
	}

	# the gate's own endpoints (login start, OIDC callback, sign-out)
	handle /oauth2/* {
		reverse_proxy gate:4180
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Robots-Tag "noindex, nofollow"
		X-Overwatch-Env "sandbox"
		-Server
	}
}

# ---- sandbox site ----------------------------------------------------------
# `:80` stays as a fallback so direct access to 127.0.0.1:8190 (health checks,
# debugging) keeps working when no matching Host header is sent.
http://sandbox.overwatch.confinia.io, :80 {
	import sandbox_common

	# Identity: the ONE shared Keycloak serves /auth — realm overwatch-sandbox
	# (dedicated to this env; prod uses realm overwatch on the same instance).
	# Reached over the ovw2_default network, mirroring the prod app caddy.
	handle /auth* {
		reverse_proxy ovw2_keycloak_1:8080
	}

	handle /api/v1* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle /v1* {
		redir * /api{uri} 308
	}

	handle /grafana* {
		# Grafana supports basic auth and would read a replayed Authorization
		# header as a login attempt for a user it does not know, answering 401
		# and ignoring the valid OIDC session cookie (#149). Its own auth is
		# that cookie (or anonymous); nothing a caller sends stands in for it.
		reverse_proxy grafana:3000 {
			header_up -Authorization
		}
	}

	handle {
		reverse_proxy web:8080
	}
}

# ---- sandbox API on its own hostname ---------------------------------------
# Serves the API at the root (/v1/...). /api/v1/... also works here: FastAPI
# runs with root_path=/api, so its docs and openapi.json resolve URLs under
# that prefix — stripping it lets /v1/docs work on this host too.
http://sandbox.api.overwatch.confinia.io {
	import sandbox_common

	handle /api/v1* {
		uri strip_prefix /api
		reverse_proxy api:8000
	}

	handle /v1* {
		reverse_proxy api:8000
	}

	handle {
		redir * /v1 308
	}
}
