# Overwatch SANDBOX stack env — copy to .env on the VM and fill in.
# .env is gitignored (secrets). This isolated stack talks to Polar SANDBOX only.

# --- Polar SANDBOX (from sandbox.polar.sh) ---------------------------------
# Leave the ids blank + keep POLAR_ALLOW_STUB=1 (in docker-compose.yml) to
# validate the flow BEFORE you have sandbox creds. Fill them to talk to real
# Polar sandbox, then set a real POLAR_WEBHOOK_SECRET (and drop the stub).
POLAR_API_BASE=https://sandbox-api.polar.sh
POLAR_ORG_TOKEN=
POLAR_PRODUCT_ID_PRO=
POLAR_METER_ID_FRAMES=
POLAR_METER_ID_TM=
POLAR_METER_ID_TC=
POLAR_WEBHOOK_SECRET=

# --- Public-fleet clone (ingest) -------------------------------------------
# SatNOGS API token so the sandbox globe clones prod's public fleet. Can reuse
# the prod token (read-only upstream) or leave blank for a data-empty sandbox.
SATNOGS_TOKEN=

# --- Identity: shared Keycloak, dedicated realm overwatch-sandbox ----------
# Client secret of the `overwatch` client IN THE SANDBOX REALM (created by
# batch/kc_sandbox_realm.py — distinct from the prod realm's secret), plus the
# Keycloak admin credentials (same instance as prod, from orbit-poc/.env) used
# by the api for self-serve organization creation.
OVERWATCH_CLIENT_SECRET=
KC_ADMIN_USERNAME=
KC_ADMIN_PASSWORD=

# --- App secrets (sandbox-only values; do NOT reuse prod secrets) ----------
ORG_DB_SECRET=change-me-sandbox-only
GF_SECURITY_ADMIN_PASSWORD=change-me-sandbox-only

# Grafana datasource role (SECURITY #129). Grafana's datasource proxy executes
# arbitrary SQL for ANY caller — including the anonymous Viewer the public
# embeds require — so the datasource must NOT use the app's `orbit` role.
# The API provisions a `grafana_ro` role (NOSUPERUSER, NOBYPASSRLS, SELECT on
# the public tables only) with this password; Grafana authenticates with it.
#   openssl rand -hex 20
GRAFANA_DB_PASSWORD=
