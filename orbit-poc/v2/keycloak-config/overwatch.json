{
  "realm": "overwatch",
  "enabled": true,
  "verifyEmail": true,
  "smtpServer": {
    "host": "$(env:SMTP_HOST)",
    "port": "$(env:SMTP_PORT)",
    "from": "$(env:SMTP_FROM)",
    "fromDisplayName": "Overwatch",
    "replyTo": "$(env:ALERT_RCPT)",
    "ssl": "false",
    "starttls": "true",
    "auth": "true",
    "user": "$(env:SMTP_USER)",
    "password": "$(env:SMTP_PASSWORD)"
  },
  "resetPasswordAllowed": true,
  "eventsEnabled": true,
  "eventsExpiration": 1209600
}
