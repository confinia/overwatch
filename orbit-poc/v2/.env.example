# Overwatch v2 stack secrets (Keycloak + keycloak-config-cli). VM-side only —
# copy to v2/.env and fill; never commit real values.
#
# EVERY key below is REQUIRED. Dropping one breaks the stack on the next
# `make v2-up` — and all login (prod + staging + sandbox share this one
# Keycloak, ovw2_keycloak_1). test_keycloak_config.py guards this list.

# --- Postgres (Keycloak's own database) ---
POSTGRES_PASSWORD=change-me
KC_DB_PASSWORD=change-me              # must EQUAL POSTGRES_PASSWORD (same DB user)

# --- Keycloak bootstrap admin ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Overwatch OIDC client secret (shared with the api + Grafana OAuth) ---
OVERWATCH_CLIENT_SECRET=change-me

# --- keycloak-config-cli (#182): admin creds under the names the CLI reads ---
KEYCLOAK_USER=admin                  # = KC_BOOTSTRAP_ADMIN_USERNAME
KEYCLOAK_PASSWORD=change-me          # = KC_BOOTSTRAP_ADMIN_PASSWORD

# --- SMTP for the realm e-mails (#195): the config-cli substitutes these into
#     the realm JSON via $(env:...) — one place for host/port/from/user/pw ---
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=587
SMTP_USER=alert@confinia.io
SMTP_PASSWORD=change-me              # the mailbox password
SMTP_FROM=alert@confinia.io
ALERT_RCPT=contact@confinia.io       # realm replyTo (human contact)

# --- Internal gate realm overwatch-gate (#290): the oauth2-proxy client
#     secrets, one per gated environment. The config-cli substitutes them into
#     keycloak-config/overwatch-gate.json; the SAME values go into
#     sandbox/.env and staging/.env as OAUTH2_PROXY_CLIENT_SECRET.
#       openssl rand -base64 32
GATE_CLIENT_SECRET_SANDBOX=change-me
GATE_CLIENT_SECRET_STAGING=change-me
