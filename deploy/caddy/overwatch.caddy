# MIRROR of the overwatch blocks on the shared confinia edge. NOT a source.
#
# The edge is the truth and this file is a copy of it. Regenerate it FROM the
# running edge; never apply it TO the edge. That direction matters: this file
# spent two weeks claiming port 8090, which the 1PESI migration decommissioned
# on 2026-08-15 (#213), and nothing has listened there since. Applying it
# would have 502'd production, staging and sandbox at once, dropped the three
# api.* hostnames along with their certificates, and collapsed three
# environments into one block. The platform session caught it on 2026-08-31
# rather than applying it.
#
# Ports are published by each stack's own caddy on loopback:
#   orbit-poc_caddy_1   -> 127.0.0.1:12000   (production, blue/green inside)
#   ovw-staging_caddy_1 -> 127.0.0.1:12300   (its own stack, its own database)
#   ovw-sandbox_caddy_1 -> 127.0.0.1:12400   (isolated; never shares with prod)
#
# One block per environment, deliberately: sandbox must never ride on the
# production port, and a single collapsed block is how that happens by
# accident. Each hostname must also resolve to the edge, or TLS is never
# requested for it and the handshake simply fails.
#
# To ADD a hostname, ask for a one-line change to the block it belongs to.
# A whole-file replacement cannot be verified against what is actually
# running, which is exactly how this file rotted unnoticed.

overwatch.confinia.io, api.overwatch.confinia.io, grafana.overwatch.confinia.io {
	reverse_proxy 127.0.0.1:12000
}

staging.overwatch.confinia.io, staging.api.overwatch.confinia.io {
	reverse_proxy 127.0.0.1:12300
}

sandbox.overwatch.confinia.io, sandbox.api.overwatch.confinia.io {
	reverse_proxy 127.0.0.1:12400
}
