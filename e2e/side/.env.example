# e2e/side/.env — copy to .env and fill in. NEVER committed (see .gitignore).
#
# Which environment the walk drives. sandbox and staging only: production runs
# POLAR_ENV=off and must never see a card. run.sh refuses anything else.
TARGET_ENV=sandbox

# The basic-auth gate in front of sandbox/staging. Same credentials you type in
# the browser at https://sandbox.overwatch.confinia.io
GATE_USER=overwatch
GATE_PASS=

# Password given to the disposable user the walk registers. Any value that
# satisfies the realm policy; it is thrown away with the user at teardown.
SIGNUP_PASS=

# Keycloak admin, used for exactly two things: marking the freshly registered
# user's e-mail verified (the realm has verifyEmail=true) and deleting the user
# at teardown. Keycloak is bound to VM loopback, so from the Mac open a tunnel:
#   ssh -N -L 12070:127.0.0.1:12070 overwatch
KC_ADMIN_BASE=http://127.0.0.1:12070
KC_REALM=overwatch-sandbox
KC_ADMIN_USERNAME=overwatch-svc
KC_ADMIN_PASSWORD=

# Polar SANDBOX organization access token — read-only use here: the report step
# asks sandbox.polar.sh whether the order the browser walk claims to have paid
# actually exists. Get it from https://sandbox.polar.sh -> Settings -> Tokens.
POLAR_API_BASE=https://sandbox-api.polar.sh
POLAR_ORG_TOKEN=

# Optional: keep the disposable user and organization after the run, to poke at
# them by hand. Default is to delete them.
KEEP_USER=0
