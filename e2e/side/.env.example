# e2e/side/.env — copy to .env and fill in. NEVER committed (see .gitignore).
#
# Which environment the walk drives. sandbox and staging only: production has
# billing off and must never see a card. run.sh refuses anything else.
TARGET_ENV=sandbox

# The SSO gate in front of sandbox/staging (#290) needs no credential here: the
# run creates its own disposable account in the overwatch-gate realm with a
# generated password, using the Keycloak admin below, and deletes it afterwards.
# Override only to point at a different gate realm or role.
#GATE_REALM=overwatch-gate
#GATE_ROLE=internal

# Password given to the disposable user the walk registers. Any value that
# satisfies the realm policy; it is thrown away with the user at teardown.
SIGNUP_PASS=

# Keycloak admin, used for three things: creating and removing the run's gate
# account, marking the freshly registered user's e-mail verified (the realm has
# verifyEmail=true), and deleting that user at teardown. Keycloak is bound to VM loopback, so from the Mac open a tunnel:
#   ssh -N -L 12070:127.0.0.1:12070 overwatch
KC_ADMIN_BASE=http://127.0.0.1:12070
KC_REALM=overwatch-sandbox
KC_ADMIN_USERNAME=overwatch-svc
KC_ADMIN_PASSWORD=

# Creem TEST-MODE API key (rule 27) — the report step asks test-api.creem.io
# whether the subscription the browser walk claims to have paid actually
# exists. Must start with creem_test_; the report refuses production keys.
# Same key the sandbox stack uses in orbit-poc/sandbox/.env.
CREEM_API_BASE=
CREEM_API_KEY=

# Optional: keep the disposable user and organization after the run, to poke at
# them by hand. Default is to delete them.
KEEP_USER=0
