  "suites": [
    {
      "id": "s-register",
      "name": "register",
      "persistSession": false,
      "parallel": false,
      "timeout": 600,
      "tests": [
        "t-register"
      ]
    },
    {
      "id": "s-pay",
      "name": "pay",
      "persistSession": false,
      "parallel": false,
      "timeout": 900,
      "tests": [
        "t-pay"
      ]
    }
  ],
  "urls": [
    "https://sandbox.overwatch.confinia.io",
    "https://staging.overwatch.confinia.io"
  ],
  "plugins": []
