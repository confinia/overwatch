{
  "id": "9f5a1c30-6d2e-4b7a-9c31-0e1f2a3b4c5d",
  "version": "2.0",
  "name": "Overwatch — registration and payment",
  "url": "https://sandbox.overwatch.confinia.io",
  "tests": [
    {
      "id": "t-register",
      "name": "register",
      "commands": [
        {
          "id": "c001",
          "comment": "run.sh derives this from TARGET_ENV in .env.",
          "command": "store",
          "target": "__BASE__",
          "targets": [],
          "value": "BASE"
        },
        {
          "id": "c002",
          "comment": "BASE with the basic-auth gate credentials embedded: Chrome honours user:pass@ on a top-level navigation, and Selenium has no other way past the gate.",
          "command": "store",
          "target": "__GATED_BASE__",
          "targets": [],
          "value": "GATED_BASE"
        },
        {
          "id": "c003",
          "comment": "Disposable per-run address. A fixed one re-links to a soft-deleted org tombstone.",
          "command": "store",
          "target": "__SIGNUP_EMAIL__",
          "targets": [],
          "value": "EMAIL"
        },
        {
          "id": "c004",
          "comment": "",
          "command": "store",
          "target": "__SIGNUP_PASS__",
          "targets": [],
          "value": "PASS"
        },
        {
          "id": "c005",
          "comment": "",
          "command": "store",
          "target": "__ORG_NAME__",
          "targets": [],
          "value": "ORG"
        },
        {
          "id": "c006",
          "comment": "Polar/Stripe sandbox test card. Never a real number: run.sh forbids production.",
          "command": "store",
          "target": "4242424242424242",
          "targets": [],
          "value": "CARD"
        },
        {
          "id": "c007",
          "comment": "",
          "command": "store",
          "target": "12 / 34",
          "targets": [],
          "value": "CARD_EXP"
        },
        {
          "id": "c008",
          "comment": "",
          "command": "store",
          "target": "123",
          "targets": [],
          "value": "CARD_CVC"
        },
        {
          "id": "c009",
          "comment": "",
          "command": "store",
          "target": "E2E Bot",
          "targets": [],
          "value": "CARD_NAME"
        },
        {
          "id": "c023",
          "comment": "",
          "command": "echo",
          "target": ">> step 1: open ${GATED_BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "c010",
          "comment": "The account page is the entry point: signup, org creation and payment all start here.",
          "command": "open",
          "target": "${GATED_BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "c024",
          "comment": "",
          "command": "echo",
          "target": ">> step 2: waitForElementVisible id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c011",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=act-signin",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "c025",
          "comment": "",
          "command": "echo",
          "target": ">> step 3: click id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c012",
          "comment": "",
          "command": "click",
          "target": "id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c026",
          "comment": "",
          "command": "echo",
          "target": ">> step 4: waitForElementVisible id=kc-registration",
          "targets": [],
          "value": ""
        },
        {
          "id": "c013",
          "comment": "Keycloak login screen. Self-registration is on, so it offers a Register link.",
          "command": "waitForElementVisible",
          "target": "id=kc-registration",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "c027",
          "comment": "",
          "command": "echo",
          "target": ">> step 5: click css=#kc-registration a",
          "targets": [],
          "value": ""
        },
        {
          "id": "c014",
          "comment": "",
          "command": "click",
          "target": "css=#kc-registration a",
          "targets": [],
          "value": ""
        },
        {
          "id": "c028",
          "comment": "",
          "command": "echo",
          "target": ">> step 6: waitForElementVisible id=firstName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c015",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=firstName",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "c029",
          "comment": "",
          "command": "echo",
          "target": ">> step 7: type id=firstName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c016",
          "comment": "",
          "command": "type",
          "target": "id=firstName",
          "targets": [],
          "value": "E2E"
        },
        {
          "id": "c030",
          "comment": "",
          "command": "echo",
          "target": ">> step 8: type id=lastName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c017",
          "comment": "",
          "command": "type",
          "target": "id=lastName",
          "targets": [],
          "value": "Bot"
        },
        {
          "id": "c031",
          "comment": "",
          "command": "echo",
          "target": ">> step 9: type id=email",
          "targets": [],
          "value": ""
        },
        {
          "id": "c018",
          "comment": "registrationEmailAsUsername is on, so the address IS the username — no username field.",
          "command": "type",
          "target": "id=email",
          "targets": [],
          "value": "${EMAIL}"
        },
        {
          "id": "c032",
          "comment": "",
          "command": "echo",
          "target": ">> step 10: type id=password",
          "targets": [],
          "value": ""
        },
        {
          "id": "c019",
          "comment": "",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "${PASS}"
        },
        {
          "id": "c033",
          "comment": "",
          "command": "echo",
          "target": ">> step 11: type id=password-confirm",
          "targets": [],
          "value": ""
        },
        {
          "id": "c020",
          "comment": "",
          "command": "type",
          "target": "id=password-confirm",
          "targets": [],
          "value": "${PASS}"
        },
        {
          "id": "c034",
          "comment": "",
          "command": "echo",
          "target": ">> step 12: click css=input[type=submit]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c021",
          "comment": "",
          "command": "click",
          "target": "css=input[type=submit]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c035",
          "comment": "",
          "command": "echo",
          "target": ">> step 13: waitForElementNotPresent id=password-confirm",
          "targets": [],
          "value": ""
        },
        {
          "id": "c022",
          "comment": "The form is gone: the account exists. The realm has verifyEmail=true, so Keycloak now parks the session on the 'verify your email' notice. run.sh marks the user verified through the admin API before the pay suite.",
          "command": "waitForElementNotPresent",
          "target": "id=password-confirm",
          "targets": [],
          "value": "30000"
        }
      ]
    },
