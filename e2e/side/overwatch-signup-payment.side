        },
        {
          "id": "t20m8",
          "comment": "",
          "command": "echo",
          "target": ">> 20 sign in step 8: waitForElementVisible id=act-create-org",
          "targets": [],
          "value": ""
        },
        {
          "id": "c908",
          "comment": "Signed in, no organization yet — so the account page offers to create one.",
          "command": "waitForElementVisible",
          "target": "id=act-create-org",
          "targets": [],
          "value": "60000"
        }
      ]
    },
    {
      "id": "t30",
      "name": "30 create org",
      "commands": [
        {
          "id": "t30m1",
          "comment": "",
          "command": "echo",
          "target": ">> 30 create org step 1: answerOnNextPrompt ${ORG}",
          "targets": [],
          "value": ""
        },
        {
          "id": "c033",
          "comment": "createOrg() asks for the name with prompt().",
          "command": "answerOnNextPrompt",
          "target": "${ORG}",
          "targets": [],
          "value": ""
        },
        {
          "id": "t30m2",
          "comment": "",
          "command": "echo",
          "target": ">> 30 create org step 2: click id=act-create-org",
          "targets": [],
          "value": ""
        },
        {
          "id": "c034",
          "comment": "",
          "command": "click",
          "target": "id=act-create-org",
          "targets": [],
          "value": ""
        },
        {
          "id": "t30m3",
          "comment": "",
          "command": "echo",
          "target": ">> 30 create org step 3: assertAlert Organization created — signing you in again to activate it.",
          "targets": [],
          "value": ""
        },
        {
          "id": "c035",
          "comment": "Keycloak only puts the organization in the token at login, so the app signs in again (#157).",
          "command": "assertAlert",
          "target": "Organization created — signing you in again to activate it.",
          "targets": [],
          "value": ""
        },
        {
          "id": "t30m4",
          "comment": "",
          "command": "echo",
          "target": ">> 30 create org step 4: waitForElementVisible id=act-upgrade",
          "targets": [],
          "value": ""
        },
        {
          "id": "c036",
          "comment": "Back on the account page WITH an organization, on the free plan.",
          "command": "waitForElementVisible",
          "target": "id=act-upgrade",
          "targets": [],
          "value": "60000"
        },
        {
          "id": "t30m5",
          "comment": "",
          "command": "echo",
          "target": ">> 30 create org step 5: assertText id=plan",
          "targets": [],
          "value": ""
        },
        {
          "id": "c037",
          "comment": "",
          "command": "assertText",
          "target": "id=plan",
          "targets": [],
          "value": "FREE"
        }
      ]
    },
    {
      "id": "t40",
      "name": "40 checkout",
      "commands": [
        {
          "id": "t40m1",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 1: click id=act-upgrade",
          "targets": [],
          "value": ""
        },
        {
          "id": "c038",
          "comment": "POST /v1/billing/checkout mints a real Polar sandbox checkout and navigates to it.",
          "command": "click",
          "target": "id=act-upgrade",
          "targets": [],
          "value": ""
        },
        {
          "id": "t40m2",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 2: waitForElementVisible css=input[type='email'], input[name='email']",
          "targets": [],
          "value": ""
        },
        {
          "id": "c039",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=input[type='email'], input[name='email']",
          "targets": [],
          "value": "60000"
        },
        {
          "id": "t40m3",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 3: executeScript return location.host",
          "targets": [],
          "value": ""
        },
        {
          "id": "c401",
          "comment": "Guard rail: the walk must be on Polar SANDBOX, never the production host.",
          "command": "executeScript",
          "target": "return location.host",
          "targets": [],
          "value": "CHECKOUT_HOST"
        },
        {
          "id": "t40m4",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 4: assert CHECKOUT_HOST",
          "targets": [],
          "value": ""
        },
        {
          "id": "c402",
          "comment": "",
          "command": "assert",
          "target": "CHECKOUT_HOST",
          "targets": [],
          "value": "sandbox.polar.sh"
        },
        {
          "id": "t40m5",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 5: executeScript return location.pathname.split('/').pop()",
          "targets": [],
          "value": ""
        },
        {
          "id": "c041",
          "comment": "",
          "command": "executeScript",
          "target": "return location.pathname.split('/').pop()",
          "targets": [],
          "value": "CHECKOUT_ID"
        },
        {
          "id": "t40m6",
          "comment": "",
          "command": "echo",
          "target": ">> 40 checkout step 6: echo Polar sandbox checkout ${CHECKOUT_ID}",
          "targets": [],
          "value": ""
        },
        {
          "id": "c042",
          "comment": "",
          "command": "echo",
          "target": "Polar sandbox checkout ${CHECKOUT_ID}",
          "targets": [],
          "value": ""
        }
      ]
    },
