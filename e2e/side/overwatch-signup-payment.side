        },
        {
          "id": "t20m5",
          "comment": "",
          "command": "echo",
          "target": ">> 20 sign in step 5: waitForElementVisible id=password",
          "targets": [],
          "value": ""
        },
        {
          "id": "c905",
          "comment": "Second screen of the identity-first flow.",
          "command": "waitForElementVisible",
          "target": "id=password",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "t20m6",
          "comment": "",
          "command": "echo",
          "target": ">> 20 sign in step 6: type id=password",
          "targets": [],
