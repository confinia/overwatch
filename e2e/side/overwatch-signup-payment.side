{
  "id": "9f5a1c30-6d2e-4b7a-9c31-0e1f2a3b4c5d",
  "version": "2.0",
  "name": "Overwatch — registration and payment",
  "url": "https://sandbox.overwatch.confinia.io",
  "tests": [
    {
      "id": "t-register",
      "name": "register",
      "commands": [
        {
          "id": "c001",
          "comment": "run.sh derives this from TARGET_ENV in .env.",
          "command": "store",
          "target": "__BASE__",
          "targets": [],
          "value": "BASE"
        },
        {
          "id": "c003",
          "comment": "Disposable per-run address. A fixed one re-links to a soft-deleted org tombstone.",
          "command": "store",
          "target": "__SIGNUP_EMAIL__",
          "targets": [],
          "value": "EMAIL"
        },
        {
          "id": "c004",
          "comment": "",
          "command": "store",
          "target": "__SIGNUP_PASS__",
          "targets": [],
          "value": "PASS"
        },
        {
          "id": "c005",
          "comment": "",
          "command": "store",
          "target": "__ORG_NAME__",
          "targets": [],
          "value": "ORG"
        },
        {
          "id": "c006",
          "comment": "Creem test-mode card (docs.creem.io): any future expiry, any CVC. Never a real number: run.sh forbids production.",
          "command": "store",
          "target": "4111111111111111",
          "targets": [],
          "value": "CARD"
        },
        {
          "id": "c007",
          "comment": "",
