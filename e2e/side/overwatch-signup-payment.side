{
  "id": "9f5a1c30-6d2e-4b7a-9c31-0e1f2a3b4c5d",
  "version": "2.0",
  "name": "Overwatch — registration and payment",
  "url": "https://sandbox.overwatch.confinia.io",
  "tests": [
    {
      "id": "t00",
      "name": "00 config",
      "commands": [
        {
          "id": "c001",
          "comment": "Target environment. run.sh derives this from TARGET_ENV in .env.",
          "command": "store",
          "target": "https://sandbox.overwatch.confinia.io",
          "targets": [],
          "value": "BASE"
        },
        {
          "id": "c002",
          "comment": "basic-auth gate on sandbox/staging",
          "command": "store",
          "target": "__GATE_USER__",
          "targets": [],
          "value": "GATE_USER"
        },
        {
          "id": "c003",
          "comment": "",
          "command": "store",
          "target": "__GATE_PASS__",
          "targets": [],
          "value": "GATE_PASS"
        },
        {
          "id": "c004",
          "comment": "Disposable per-run address. A fixed one re-links to a soft-deleted org tombstone.",
          "command": "store",
          "target": "__SIGNUP_EMAIL__",
          "targets": [],
          "value": "EMAIL"
        },
        {
          "id": "c005",
          "comment": "",
          "command": "store",
          "target": "__SIGNUP_PASS__",
          "targets": [],
          "value": "PASS"
        },
        {
          "id": "c006",
          "comment": "",
          "command": "store",
          "target": "__ORG_NAME__",
          "targets": [],
          "value": "ORG"
        },
        {
          "id": "c007",
          "comment": "Polar/Stripe sandbox test card. Never a real number: TARGET_ENV forbids production.",
          "command": "store",
          "target": "4242424242424242",
          "targets": [],
          "value": "CARD"
        },
        {
          "id": "c008",
          "comment": "",
          "command": "store",
          "target": "12 / 34",
          "targets": [],
          "value": "CARD_EXP"
        },
        {
          "id": "c009",
          "comment": "",
          "command": "store",
          "target": "123",
          "targets": [],
          "value": "CARD_CVC"
        },
        {
          "id": "c010",
          "comment": "",
          "command": "store",
          "target": "E2E Bot",
          "targets": [],
          "value": "CARD_NAME"
        },
        {
          "id": "c012",
          "comment": "Basic-auth credentials in the URL: Chrome still honours them on a top-level navigation, and Selenium has no other way past the gate. run.sh renders this from .env.",
          "command": "store",
          "target": "__GATED_BASE__",
          "targets": [],
          "value": "GATED_BASE"
        }
      ]
    },
    {
      "id": "t10",
      "name": "10 register",
      "commands": [
        {
          "id": "t10m1",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 1: setWindowSize 1280x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "c013",
          "comment": "",
          "command": "setWindowSize",
          "target": "1280x900",
          "targets": [],
          "value": ""
        },
        {
          "id": "t10m2",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 2: open ${GATED_BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "c014",
          "comment": "The account page is the entry point: it is where signup, org creation and payment all start.",
          "command": "open",
          "target": "${GATED_BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "t10m3",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 3: waitForElementVisible id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c015",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=act-signin",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "t10m4",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 4: click id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c016",
          "comment": "",
          "command": "click",
          "target": "id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "t10m5",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 5: waitForElementVisible id=kc-registration",
          "targets": [],
          "value": ""
        },
        {
          "id": "c017",
          "comment": "Keycloak login screen. Self-registration is on, so it offers a Register link.",
          "command": "waitForElementVisible",
          "target": "id=kc-registration",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "t10m6",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 6: click css=#kc-registration a",
          "targets": [],
          "value": ""
        },
        {
          "id": "c018",
          "comment": "",
          "command": "click",
          "target": "css=#kc-registration a",
          "targets": [],
          "value": ""
        },
        {
          "id": "t10m7",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 7: waitForElementVisible id=firstName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c019",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=firstName",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "t10m8",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 8: type id=firstName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c020",
          "comment": "",
          "command": "type",
          "target": "id=firstName",
          "targets": [],
          "value": "E2E"
        },
        {
          "id": "t10m9",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 9: type id=lastName",
          "targets": [],
          "value": ""
        },
        {
          "id": "c021",
          "comment": "",
          "command": "type",
          "target": "id=lastName",
          "targets": [],
          "value": "Bot"
        },
        {
          "id": "t10m10",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 10: type id=email",
          "targets": [],
          "value": ""
        },
        {
          "id": "c022",
          "comment": "registrationEmailAsUsername is on, so the address IS the username — no username field.",
          "command": "type",
          "target": "id=email",
          "targets": [],
          "value": "${EMAIL}"
        },
        {
          "id": "t10m11",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 11: type id=password",
          "targets": [],
          "value": ""
        },
        {
          "id": "c023",
          "comment": "",
          "command": "type",
          "target": "id=password",
          "targets": [],
          "value": "${PASS}"
        },
        {
          "id": "t10m12",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 12: type id=password-confirm",
          "targets": [],
          "value": ""
        },
        {
          "id": "c024",
          "comment": "",
          "command": "type",
          "target": "id=password-confirm",
          "targets": [],
          "value": "${PASS}"
        },
        {
          "id": "t10m13",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 13: click css=input[type=submit]",
          "targets": [],
          "value": ""
        },
        {
          "id": "c025",
          "comment": "",
          "command": "click",
          "target": "css=input[type=submit]",
          "targets": [],
          "value": ""
        },
        {
          "id": "t10m14",
          "comment": "",
          "command": "echo",
          "target": ">> 10 register step 14: waitForElementNotPresent id=password-confirm",
          "targets": [],
          "value": ""
        },
        {
          "id": "c026",
          "comment": "The form is gone: the account exists. The realm has verifyEmail=true, so Keycloak now parks the session on the 'verify your email' notice. run.sh marks the disposable user verified through the Keycloak admin API before the next test.",
          "command": "waitForElementNotPresent",
          "target": "id=password-confirm",
          "targets": [],
          "value": "30000"
        }
      ]
    },
    {
      "id": "t20",
      "name": "20 sign in",
      "commands": [
        {
          "id": "t20m1",
          "comment": "",
          "command": "echo",
          "target": ">> 20 sign in step 1: open ${GATED_BASE}/api/v1/auth/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "c901",
          "comment": "Fresh browser: the previous test ended on Keycloak's verify-email notice.",
          "command": "open",
          "target": "${GATED_BASE}/api/v1/auth/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "t20m2",
          "comment": "",
