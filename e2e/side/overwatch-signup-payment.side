    {
      "id": "t60",
      "name": "60 entitlement",
      "commands": [
        {
          "id": "t60m1",
          "comment": "",
          "command": "echo",
          "target": ">> 60 entitlement step 1: assertElementPresent id=banner",
          "targets": [],
          "value": ""
        },
        {
          "id": "c053",
          "comment": "",
          "command": "assertElementPresent",
          "target": "id=banner",
          "targets": [],
          "value": ""
        },
        {
          "id": "t60m2",
          "comment": "",
          "command": "echo",
          "target": ">> 60 entitlement step 2: assertText id=plan",
          "targets": [],
          "value": ""
        },
        {
          "id": "c054",
          "comment": "The badge reads billing status from the API, which the Polar WEBHOOK flipped — this asserts the whole checkout -> webhook -> entitlement chain, not just the redirect.",
          "command": "assertText",
          "target": "id=plan",
          "targets": [],
          "value": "PRO"
        },
        {
          "id": "t60m3",
          "comment": "",
          "command": "echo",
          "target": ">> 60 entitlement step 3: assertElementPresent id=act-portal",
          "targets": [],
          "value": ""
        },
        {
          "id": "c055",
          "comment": "A Pro org is offered the customer portal instead of Upgrade.",
          "command": "assertElementPresent",
          "target": "id=act-portal",
          "targets": [],
          "value": ""
        }
      ]
    }
  ],
  "suites": [
    {
      "id": "s-register",
      "name": "register",
      "persistSession": true,
      "parallel": false,
      "timeout": 600,
      "tests": [
        "t00",
        "t10"
      ]
    },
    {
      "id": "s-pay",
      "name": "pay",
      "persistSession": true,
      "parallel": false,
      "timeout": 900,
      "tests": [
        "t00",
        "t20",
        "t30",
        "t40",
        "t50",
        "t60"
      ]
    }
