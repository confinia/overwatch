          "comment": "",
          "command": "store",
          "target": "E2E Bot",
          "targets": [],
          "value": "CARD_NAME"
        },
        {
          "id": "t-register-m1",
          "comment": "",
          "command": "echo",
          "target": ">> step 1: open ${BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "c010",
          "comment": "The account page is the entry point: signup, org creation and payment all start here.",
          "command": "open",
          "target": "${BASE}/w/account",
          "targets": [],
          "value": ""
        },
        {
          "id": "t-register-m2",
          "comment": "",
          "command": "echo",
          "target": ">> step 2: waitForElementVisible id=act-signin",
          "targets": [],
          "value": ""
        },
        {
          "id": "c011",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "id=act-signin",
          "targets": [],
          "value": "60000"
        },
        {
          "id": "t-register-m3",
          "comment": "",
          "command": "echo",
          "target": ">> step 3: executeAsyncScript Promise.all([fetch('/api/v1/me').then(function(r){return 'me='+r.status}).catch(function(e){return 'me=ERR:'+e}),fetch('/api/v1/auth/login').then(func",
          "targets": [],
          "value": ""
        },
        {
          "id": "np1",
          "comment": "diagnose: can the plain-URL page reach the API and the auth chain at all?",
          "command": "executeAsyncScript",
          "target": "Promise.all([fetch('/api/v1/me').then(function(r){return 'me='+r.status}).catch(function(e){return 'me=ERR:'+e}),fetch('/api/v1/auth/login').then(function(r){return 'login='+r.status+'@'+r.url}).catch(function(e){return 'login=ERR:'+e}),fetch('/auth/realms/overwatch-sandbox/.well-known/openid-configuration').then(function(r){return 'kc='+r.status}).catch(function(e){return 'kc=ERR:'+e})]).then(function(a){return a.join(' # ')})",
          "targets": [],
          "value": "NET"
        },
        {
          "id": "t-register-m4",
          "comment": "",
          "command": "echo",
          "target": ">> step 4: echo NET ${NET}",
          "targets": [],
          "value": ""
        },
