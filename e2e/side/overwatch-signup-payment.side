        },
        {
          "id": "c022",
          "comment": "The form is gone: the account exists. The realm has verifyEmail=true, so Keycloak now parks the session on the 'verify your email' notice. run.sh marks the user verified through the admin API before the pay suite.",
          "command": "waitForElementNotPresent",
          "target": "id=password-confirm",
          "targets": [],
          "value": "60000"
        }
